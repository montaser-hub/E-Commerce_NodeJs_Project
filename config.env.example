# Copy to config.env (git-ignored) and fill in. `npm run seed` fills the database with demo data.
NODE_ENV=development
PORT=3000

# Full MongoDB connection string. For Atlas, put <PASSWORD> in the URI and set DATABASE_PASSWORD.
DATABASE=mongodb://127.0.0.1:27017/furniture-shop
DATABASE_PASSWORD=

# Any long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Front-end origin: allowed by CORS and used for PayPal return URLs.
FRONTEND=http://localhost:3001

# Optional: Gmail account (app password) for verification and password-reset emails.
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Optional: PayPal sandbox checkout.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
